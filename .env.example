# Copiez ce fichier vers .env et adaptez les valeurs.
# Ne commitez jamais le fichier .env (il contient des secrets).

# Clé secrète Django — générez-en une nouvelle pour la production :
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-random-secret-key

# Mode debug (True en développement, False en production)
DEBUG=True

# Hôtes autorisés, séparés par des virgules
ALLOWED_HOSTS=localhost,127.0.0.1
