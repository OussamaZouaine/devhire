# Copiez ce fichier vers .env et adaptez les valeurs.
# Ne commitez jamais le fichier .env (il contient des secrets).

# Clé secrète Django — générez-en une nouvelle pour la production :
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-random-secret-key

# Mode debug (True en développement, False en production)
DEBUG=True

# Hôtes autorisés, séparés par des virgules
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# URL publique du site (liens dans les emails)
SITE_URL=http://127.0.0.1:8000

# Base de données PostgreSQL (obligatoire) — format postgres://utilisateur:motdepasse@hôte:port/base
# Avec Docker uniquement pour la base : docker compose up -d db  ->  postgres://devhire:devhire@localhost:5433/devhire
DATABASE_URL=postgres://postgres:postgres@localhost:5432/devhire

# Emails — affichés dans la console par défaut. Pour un vrai SMTP :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=DevHire <noreply@example.com>

# Celery — sans broker, les tâches s'exécutent immédiatement (pas besoin de Redis)
# CELERY_BROKER_URL=redis://localhost:6379/0

# Connexion Google (optionnel) — https://console.cloud.google.com/apis/credentials
# URI de redirection autorisée : http://127.0.0.1:8000/auth/google/login/callback/
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Mettre HTTPS=True en production derrière un proxy TLS (cookies sécurisés, HSTS, redirection)
# HTTPS=False
